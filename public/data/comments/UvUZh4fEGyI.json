    },
    {
      "id": "UgxCY-pa-X7rVGws3cF4AaABAg",
      "author": "@UntoldEarthDocs_Us",
      "authorImage": "https://yt3.ggpht.com/ZBd-JMMkL6zhMliffSmhyPk1TIaKZ5JidEdsIraZMQPdMuYIOBdvvSAGJb9uvxlHQuzZXo3keA=s48-c-k-c0x00ffffff-no-rj",
      "text": "\"No Stress\" isn't just a slogan in Cape Verde... it feels like an entire philosophy of life. I wonder how different our lives would be if more countries embraced that mindset.",
      "likeCount": 2,
      "publishedAt": "2026-08-06T11:58:53Z",
      "replyCount": 1,
      "replies": [
        {
