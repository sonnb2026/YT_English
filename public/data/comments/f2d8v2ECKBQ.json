    {
      "id": "UgywkvdG-g1btyZHd-R4AaABAg",
      "author": "@travelintolifeus",
      "authorImage": "https://yt3.ggpht.com/CtizGHrwfYKaRxW5BABv58hFpGE9tQnFNT-I8TH_fGoI8B4onEPVK_KKSSE0C1hwyF3RGMrGwWs=s48-c-k-c0x00ffffff-no-rj",
      "text": "What fascinates me about living in Russia's coldest regions is how people have adapted their entire way of life to temperatures that would bring most of us to a standstill. I'd love to learn more about their food, family traditions, and what a normal winter day actually feels like.",
      "likeCount": 1,
      "publishedAt": "2026-11-03T14:31:13Z",
      "replyCount": 0,
      "replies": []
    },
    {
